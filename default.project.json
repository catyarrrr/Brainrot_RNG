{
  "name": "Brainrot",
  "tree": {
    "$className": "DataModel",

    "ReplicatedStorage": {
      "Shared": {
        "$path": "src/shared"
      },
      "Client": {
        "$path": "src/client",
        "$properties": {
          "RunContext": "Client"
        }
      } 
    },

    "ServerStorage": {
      "Server": {
        "$path": "src/server",
        "$properties": {
          "RunContext": "Server"
        }
      }
    }

  },

  "servePort": 45683
}